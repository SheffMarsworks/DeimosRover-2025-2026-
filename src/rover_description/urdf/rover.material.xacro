  </material>

  <material name="white">
    <color rgba="1 1 1 1" />
  </material>

  <material name="silver">
    <color rgba="0.7 0.7 0.7 1" />
  </material>

  <material name="nice_navy">
    <color rgba="0.12 0.18 0.4 1" />
  </material>

  <material name="soft_orange">
    <color rgba="0.85 0.45 0.15 1" />
  </material>

</robot>