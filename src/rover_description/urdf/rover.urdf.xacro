<?xml version="1.0"?>
<robot name="Deimos" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.141592653589793" />

  <xacro:include filename="$(find rover_description)/urdf/rover.material.xacro" />
  <xacro:include filename="$(find rover_description)/urdf/rover.gazebo.xacro" />
  <xacro:include filename="$(find rover_description)/urdf/sensors/lidar3d.xacro" />
  <xacro:include filename="$(find rover_description)/urdf/rover.trans.xacro" />
  <xacro:include filename="$(find rover_description)/urdf/rover.control.xacro" />


  <link name="base_footprint" />
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.2" rpy="0 0 0" />
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.5 0 0.1" rpy="0 0 0" />
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <link name="base_link">
    <inertial>
      <origin xyz="0.000140 -0.011273 0.154038" rpy="0 0 0" />
      <mass value="40.0" />
      <inertia
        ixx="0.897081" iyy="1.842092" izz="2.420768"
        ixy="0.000000" iyz="-0.000000" ixz="-0.060668" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="nice_navy" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <!-- Suspension link macro -->
  <xacro:macro name="suspension_link" params="name side">
    <link name="${name}">
      <inertial>
        <origin xyz="0 ${side * 0.044665} -0.006059" rpy="0 0 0" />
        <mass value="40.25594624417332" />
        <inertia
          ixx="0.072836" iyy="3.825904" izz="3.812794"
          ixy="0.0" iyz="${side * 0.013096}" ixz="0.0" />
      </inertial>

      <visual>
        <origin xyz="-0.023205 ${side * 0.386373} -0.118244" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://rover_description/meshes/${name}.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
        <material name="soft_orange" />
      </visual>

      <collision>
        <origin xyz="-0.023205 ${side * 0.386373} -0.118244" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://rover_description/meshes/${name}.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:suspension_link name="suspension_left" side="-1" />
  <xacro:suspension_link name="suspension_right" side="1" />

  <!-- Wheel link macro -->
  <xacro:macro name="wheel_link" params="name front_back_sign side_sign">
    <link name="${name}">
      <inertial>
        <origin xyz="0 ${side_sign * -0.06} 0" rpy="0 0 0" />
        <mass value="21.981308930926716" />
        <inertia
          ixx="0.133433" iyy="0.232318" izz="0.151641"
          ixy="0.0" iyz="0.0" ixz="0.0" />
      </inertial>

      <visual>
        <origin
          xyz="${front_back_sign * 0.475 - 0.023205} ${side_sign * 0.2951 + 0.011273} 0.061756"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://rover_description/meshes/${name}.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>

      <collision>
        <origin
          xyz="${front_back_sign * 0.475 - 0.023205} ${side_sign * 0.2951 + 0.011273} 0.061756"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://rover_description/meshes/${name}.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:wheel_link name="wheel_back_left" front_back_sign="1" side_sign="-1" />
  <xacro:wheel_link name="wheel_front_left" front_back_sign="-1" side_sign="-1" />
  <xacro:wheel_link name="wheel_back_right" front_back_sign="1" side_sign="1" />
  <xacro:wheel_link name="wheel_front_right" front_back_sign="-1" side_sign="1" />

  <!-- Suspension joint macro -->
  <xacro:macro name="suspension_joint" params="side y">
    <joint name="suspension_${side}_joint" type="fixed">
      <origin xyz="0.023205 ${y} 0.118244" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="suspension_${side}" />
    </joint>
  </xacro:macro>

  <xacro:suspension_joint side="left" y="0.363827" />
  <xacro:suspension_joint side="right" y="-0.386373" />

  <!-- Wheel joint macro -->
  <xacro:macro name="wheel_joint" params="parent child x_sign y_sign">
    <joint name="${child}_joint" type="continuous">
      <origin xyz="${x_sign * 0.475} ${y_sign * 0.08} -0.18" rpy="0 0 0" />
      <parent link="${parent}" />
      <child link="${child}" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <xacro:wheel_joint
    parent="suspension_left" child="wheel_back_left"
    x_sign="-1" y_sign="-1"
  />

  <xacro:wheel_joint
    parent="suspension_left" child="wheel_front_left"
    x_sign="1" y_sign="-1"
  />

  <xacro:wheel_joint
    parent="suspension_right" child="wheel_back_right"
    x_sign="-1" y_sign="1"
  />

  <xacro:wheel_joint
    parent="suspension_right" child="wheel_front_right"
    x_sign="1" y_sign="1"
  />


