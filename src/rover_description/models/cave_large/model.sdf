        <link name="base_link">
            <collision name="collision">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://cave_large/meshes/cave.dae</uri>
                        <scale>5.0 5.0 5.0</scale>
                    </mesh>
                </geometry>
            </collision>
            <visual name="CaveWall_visual">
                <geometry>
                    <mesh>
                        <uri>model://cave_large/meshes/cave.dae</uri>
                        <scale>5.0 5.0 5.0</scale>
                        <submesh>
                            <name>CaveWall</name>
                            <center>false</center>
                        </submesh>
                    </mesh>
                </geometry>
                <material>
                    <diffuse>1.0 1.0 1.0</diffuse>
                    <specular>1.0 1.0 1.0</specular>
                    <pbr>
                        <metal>
                            <albedo_map>model://cave_large/materials/textures/CaveWall_Albedo.png</albedo_map>
                            <normal_map>model://cave_large/materials/textures/CaveWall_Normal.png</normal_map>
                        </metal>
                    </pbr>
