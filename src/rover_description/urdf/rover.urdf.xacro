  <link name="wheel_back_right">
    <inertial>
      <origin xyz="-4.7344326215004173e-07 -0.06000028534070151 -4.99999998626599e-07" rpy="0 0 0" />
      <mass value="21.981308930926716" />
      <inertia ixx="0.133433" iyy="0.232318" izz="0.151641" ixy="0.0" iyz="-0.0" ixz="0.0" />
