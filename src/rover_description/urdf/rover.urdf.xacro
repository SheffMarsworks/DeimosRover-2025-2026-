<?xml version="1.0"?>
<robot name="Deimos" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.141592653589793" />
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001" />

  <xacro:include filename="$(find rover_description)/urdf/rover.material.xacro" />
  <xacro:include filename="$(find rover_description)/urdf/rover.gazebo.xacro" />
  <xacro:include filename="$(find rover_description)/urdf/sensors/lidar3d.xacro" />
  <!-- <xacro:include filename="$(find rover_description)/urdf/rover.trans.xacro" /> -->
  <xacro:include filename="$(find rover_description)/urdf/rover.control.xacro" />

  <link name="base_footprint" />
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="-0.375 0.235 0.222" rpy="0 0 ${-PI/2}" />
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.25 0.8 0.1" rpy="0 0 0" />
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
      <material name="dark">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
  </link>

  <!-- Chassis is 752 x 470 x 222 mm -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.23371470080552523 0.3424215459495483 0.11792924666461195" rpy="0 0 0" />
      <mass value="36.0" />
      <inertia ixx="28.457355" iyy="14.276737" izz="34.968035" ixy="0.085086" iyz="0.387247"
        ixz="-0.119086" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="nice_navy" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <link name="wheel_back_left">
    <inertial>
      <origin xyz="0.060000000000048695 9.626243984289795e-07 0.00010157518963996304" rpy="0 0 0" />
      <mass value="35.0" />
      <inertia ixx="0.234154" iyy="0.134117" izz="0.153907" ixy="-0.0" iyz="8e-06" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="0.1758 0.049434 0.072191" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel_back_left.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0.1758 0.049434 0.072191" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel_back_left.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <link name="wheel_front_left">
    <inertial>
      <origin xyz="0.05999999999997653 1.1249441103089453e-06 0.00010186480729457159" rpy="0 0 0" />
      <mass value="35.0" />
      <inertia ixx="0.234154" iyy="0.134117" izz="0.153907" ixy="-0.0" iyz="8e-06" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="0.1758 -0.800498 0.083039" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel_front_left.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0.1758 -0.800498 0.083039" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel_front_left.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <link name="wheel_back_right">
    <inertial>
      <origin xyz="-0.059999999999952314 1.1891813821787722e-06 0.00010132422446335054" rpy="0 0 0" />
      <mass value="35.0" />
      <inertia ixx="0.234154" iyy="0.134117" izz="0.153907" ixy="0.0" iyz="8e-06" ixz="-0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.6425 0.049502 0.082708" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel_back_right.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="-0.6425 0.049502 0.082708" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel_back_right.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <link name="wheel_front_right">
    <inertial>
      <origin xyz="-0.06 7.512494407269088e-05 0.00026586480728614525" rpy="0 0 0" />
      <mass value="35.0" />
      <inertia ixx="0.234154" iyy="0.134117" izz="0.153907" ixy="0.0" iyz="8e-06" ixz="-0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.6425 -0.800424 0.083203" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel_front_right.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="-0.6425 -0.800424 0.083203" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel_front_right.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <link name="suspension_right">
    <inertial>
      <origin xyz="-0.04997257661493937 0.0004804691908492642 0.02785086678998311" rpy="0 0 0" />
      <mass value="50.0" />
      <inertia ixx="3.901891" iyy="0.088961" izz="3.911318" ixy="-0.000394" iyz="0.044008"
        ixz="4.1e-05" />
    </inertial>
    <visual>
      <origin xyz="-0.63 -0.37785 -0.1081" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/suspension_right.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="soft_orange" />
    </visual>
    <collision>
      <origin xyz="-0.63 -0.37785 -0.1081" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/suspension_right.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <link name="suspension_left">
    <inertial>
      <origin xyz="0.050023043717073556 0.00048164194190997156 0.028033001206298203" rpy="0 0 0" />
      <mass value="50.0" />
      <inertia ixx="3.900293" iyy="0.087383" izz="3.911242" ixy="-0.000484" iyz="0.047745"
        ixz="2.8e-05" />
    </inertial>
    <visual>
      <origin xyz="0.1638 -0.37785 -0.1081" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/suspension_left.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="soft_orange" />
    </visual>
    <collision>
      <origin xyz="0.1638 -0.37785 -0.1081" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/suspension_left.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel_back_left_joint" type="continuous">
    <origin xyz="-0.012 -0.427284 -0.180291" rpy="0 0 0" />
    <parent link="suspension_left" />
    <child link="wheel_back_left" />
    <axis xyz="-1 0 0" />
  </joint>

  <joint name="wheel_front_left_joint" type="continuous">
    <origin xyz="-0.012 0.422648 -0.191139" rpy="0 0 0" />
    <parent link="suspension_left" />
    <child link="wheel_front_left" />
    <axis xyz="-1 0 0" />
  </joint>

  <joint name="wheel_back_right_joint" type="continuous">
    <origin xyz="0.0125 -0.427352 -0.190808" rpy="0 0 0" />
    <parent link="suspension_right" />
    <child link="wheel_back_right" />
    <axis xyz="-1 0 0" />
  </joint>

  <joint name="wheel_front_right_joint" type="continuous">
    <origin xyz="0.0125 0.422574 -0.191303" rpy="0 0 0" />
    <parent link="suspension_right" />
    <child link="wheel_front_right" />
    <axis xyz="-1 0 0" />
  </joint>

  <joint name="suspension_right_joint" type="fixed">
    <origin xyz="0.63 0.37785 0.1081" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="suspension_right" />
    <axis xyz="1.0 -0.0 0.0" />
  </joint>

  <joint name="suspension_left_joint" type="fixed">
    <origin xyz="-0.1638 0.37785 0.1081" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="suspension_left" />
    <axis xyz="-1.0 0.0 -0.0" />
  </joint>

</robot>