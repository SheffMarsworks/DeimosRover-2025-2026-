  <joint name="suspension_left_joint" type="fixed">
    <origin xyz="0.023205 0.363827 0.118244" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="suspension_left" />
    <axis xyz="0.0 1.0 -0.0" />
  </joint>

  <joint name="suspension_right_joint" type="fixed">
    <origin xyz="0.023205 -0.386373 0.118244" rpy="0 0 0" />
